<%- include('../partials/head', { title: course.code + ' report' }) %>
<%- include('../partials/course-head') %>
<div class="stats">
  <div class="card stat"><b><%= report.sessions %></b><span>Sessions held</span></div>
  <div class="card stat"><b><%= report.rows.length %></b><span>Students enrolled</span></div>
  <div class="card stat"><b><%- average === null ? '&mdash;' : average + '%' %></b><span>Average attendance</span></div>
  <div class="card stat"><b><%= flagged %></b><span>Below <%= report.threshold %>%</span></div>
</div>
<div class="toolbar"><a class="btn" href="/courses/<%= course.id %>/report.csv">Download CSV</a>
  <span class="muted">Late counts as attending. Students are flagged below <%= report.threshold %>%.</span></div>
<% if (report.rows.length) { %>
<div class="card table-wrap"><table>
  <caption class="sr-only">Attendance report</caption>
  <thead><tr><th>Matric no.</th><th>Name</th><th class="num">Present</th><th class="num">Late</th><th class="num">Absent</th><th>Attendance</th><th>Status</th></tr></thead>
  <tbody>
  <% report.rows.forEach(function (r) { %>
    <tr><td class="code"><%= r.matricNo %></td><td><%= r.fullName %></td><td class="num"><%= r.present %></td><td class="num"><%= r.late %></td><td class="num"><%= r.absent %></td>
      <td><% if (r.rate === null) { %><span class="muted">&mdash;</span><% } else { %><div class="rate"><div class="meter<%= r.belowThreshold ? ' low' : '' %>" role="img" aria-label="<%= r.rate %>% attendance"><span style="width:<%= Math.min(r.rate, 100) %>%"></span></div><b><%= r.rate %>%</b></div><% } %></td>
      <td><% if (r.rate === null) { %><span class="muted">&mdash;</span><% } else if (r.belowThreshold) { %><span class="badge badge-absent">Below <%= report.threshold %>%</span><% } else { %><span class="badge badge-present">On track</span><% } %></td></tr>
  <% }); %>
  </tbody>
</table></div>
<% } else { %><div class="card empty"><h3>No students enrolled</h3><p>Enrol students to see a report.</p></div><% } %>
<%- include('../partials/foot') %>
