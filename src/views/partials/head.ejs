<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title><%= locals.title ? title + ' - ' : '' %>Student Attendance System</title>
  <link rel="icon" href="data:,">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
<a class="skip" href="#main">Skip to main content</a>
<% if (locals.user) {
     const items = user.role === 'student'
       ? [['my', 'My attendance', '/my']]
       : [['courses', 'Courses', '/courses'], ['students', 'Students', '/students']].concat(user.role === 'admin' ? [['accounts', 'Accounts', '/accounts']] : []); %>
<header class="topbar"><div class="topbar-inner">
  <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">&#10003;</span>Attendance</a>
  <nav class="nav" aria-label="Main">
    <% items.forEach(function (i) { %><a href="<%= i[2] %>"<%- locals.nav === i[0] ? ' aria-current="page"' : '' %>><%= i[1] %></a><% }); %>
  </nav>
  <div class="who">
    <span><%= user.name %> &middot; <%= ROLE[user.role] %></span>
    <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit">Sign out</button></form>
  </div>
</div></header>
<% } %>
<main class="<%= locals.bare ? 'bare' : 'container' %>" id="main" tabindex="-1">
<% if (!locals.bare) { %><%- include('flash') %><% } %>
