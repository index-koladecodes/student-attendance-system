<%- include('../partials/head', { title: 'New account' }) %>
<p class="crumb"><a href="/accounts">Accounts</a> / New account</p>
<div class="page-head"><h1>New account</h1></div>
<div class="card card-pad narrow">
  <% if (error) { %><p class="form-error" role="alert"><%= error %></p><% } %>
  <form method="post" action="/accounts" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <%- include('../partials/field', { name: 'name', label: 'Full name', value: values.name, required: true, autofocus: true }) %>
    <%- include('../partials/field', { name: 'email', label: 'Email', type: 'email', value: values.email, required: true }) %>
    <%- include('../partials/field', { name: 'password', label: 'Temporary password', type: 'password', value: '', required: true, autocomplete: 'new-password', hint: 'At least 8 characters. Share it securely.' }) %>
    <div class="field"><label for="f-role">Role</label>
      <select id="f-role" name="role">
        <% [['lecturer', 'Lecturer'], ['admin', 'Administrator'], ['student', 'Student']].forEach(function (r) { %><option value="<%= r[0] %>"<%- values.role === r[0] ? ' selected' : '' %>><%= r[1] %></option><% }); %>
      </select></div>
    <div class="form-actions"><a class="btn" href="/accounts">Cancel</a><button class="btn btn-primary" type="submit">Create account</button></div>
  </form>
</div>
<%- include('../partials/foot') %>
